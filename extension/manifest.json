{
  "manifest_version": 3,
  "name": "Ascend – Save to Tracker",
  "version": "0.1.0",
  "description": "Save LinkedIn and Indeed job postings straight into your Ascend Roles tracker with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/jobs/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.indeed.com/*"],
      "js": ["content-indeed.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://dwiwayffvlbokffyyuwy.supabase.co/*"
  ]
}
