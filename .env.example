# Backend API base URL (Express server in server/). Defaults to the deployed
# Render URL if unset; point at http://localhost:5050 for local dev.
VITE_API_URL=http://localhost:5050

# Supabase project (Project Settings → API in the Supabase dashboard).
# VITE_SUPABASE_ANON_KEY is safe to expose in the browser (it's public by design).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
