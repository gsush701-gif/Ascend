# --- Required ---

# Backend API base URL (Express server in server/). Defaults to the deployed
# Render URL if unset; point at http://localhost:5050 for local dev.
VITE_API_URL=http://localhost:5050

# Supabase project (Project Settings → API in the Supabase dashboard).
# VITE_SUPABASE_ANON_KEY is safe to expose in the browser (it's public by design).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Optional ---

# Sentry (sentry.io) — frontend error reporting. Leave unset to skip Sentry
# entirely (no crash, no warning) — this is the default until a Sentry
# project exists for Ascend. Set to your project's DSN to activate.
VITE_SENTRY_DSN=

# Stripe (dashboard.stripe.com) — publishable/public key (safe to expose in
# the browser). Referenced by server/.env.example's STRIPE_SECRET_KEY comment
# as living here, but not currently read by any frontend code — Checkout and
# the Billing Portal are both started by the backend and redirect to a
# Stripe-hosted URL directly (server/index.js's /api/billing/* routes), so
# there's no client-side Stripe.js/Elements integration yet that would need
# this. Reserved for if/when that changes.
VITE_STRIPE_PUBLISHABLE_KEY=
