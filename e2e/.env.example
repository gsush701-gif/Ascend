# Playwright E2E test-account credentials — see docs/TESTING.md for the
# full explanation. Copy this file to .env.e2e (repo root, gitignored) and
# fill it in ONLY with a throwaway account on a SEPARATE test Supabase
# project. Never point this at production credentials.
#
# Leave both unset (the default) to run only the auth-free/public-page
# tests — every test that needs a real session calls test.skip() cleanly
# instead of failing.

E2E_TEST_ACCOUNT_EMAIL=
E2E_TEST_ACCOUNT_PASSWORD=
