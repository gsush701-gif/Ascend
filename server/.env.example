# --- Required ---

# Supabase project (Project Settings → API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is secret — never expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq (console.groq.com) — free API key, used to run an open-source LLM
# for real resume-bullet rewriting and full-resume critique.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional (sensible defaults / graceful no-op if unset) ---

# Defaults to 5050 if unset.
PORT=5050

# Comma-separated list of allowed origins. Set this to your real frontend
# URL(s) in production — do not leave as "*" once real user data is involved.
# Defaults to "*" (wildcard) if unset.
CORS_ORIGIN=http://localhost:5173

# Set by the hosting platform (Render sets this automatically) — not
# something you normally add to a local .env. When it's exactly
# "production", error responses never echo raw error text to the client.
# NODE_ENV=production

# Upstash Redis (upstash.com, free tier available) — enables Redis-backed
# rate limiting shared across multiple server instances. Leave both unset to
# keep the current in-memory, single-instance rate limiting (fine until this
# API is scaled beyond one Render instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (sentry.io) — backend error/observability reporting. Leave unset to
# skip Sentry entirely (no crash, no warning) — this is the default until a
# Sentry project exists for Ascend. Set to your project's DSN to activate.
SENTRY_DSN=
