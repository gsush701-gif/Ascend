# --- Required ---

# Supabase project (Project Settings → API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is secret — never expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional but recommended (Phase 6a) ---
# Public anon/publishable key — same value as the frontend's
# VITE_SUPABASE_ANON_KEY (Project Settings -> API), safe to expose. When set,
# server/lib/supabaseUser.js builds a per-request RLS-scoped client (using
# the caller's own access token) for ownership-checked lookups on routes like
# /api/generate-cold-email and /api/career-advice, as defense-in-depth on top
# of the explicit user_id filter. If unset, those routes fall back to the
# admin client with an explicit ownership filter (still correct, just without
# the extra RLS layer).
SUPABASE_ANON_KEY=your-anon-key

# Groq (console.groq.com) — free API key, used to run an open-source LLM
# for real resume-bullet rewriting and full-resume critique.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional (sensible defaults / graceful no-op if unset) ---

# Defaults to 5050 if unset.
PORT=5050

# Comma-separated list of allowed origins. Set this to your real frontend
# URL(s) in production — do not leave as "*" once real user data is involved.
# Defaults to "*" (wildcard) if unset.
CORS_ORIGIN=http://localhost:5173

# Set by the hosting platform (Render sets this automatically) — not
# something you normally add to a local .env. When it's exactly
# "production", error responses never echo raw error text to the client.
# NODE_ENV=production

# Upstash Redis (upstash.com, free tier available) — enables Redis-backed
# rate limiting shared across multiple server instances. Leave both unset to
# keep the current in-memory, single-instance rate limiting (fine until this
# API is scaled beyond one Render instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (sentry.io) — backend error/observability reporting. Leave unset to
# skip Sentry entirely (no crash, no warning) — this is the default until a
# Sentry project exists for Ascend. Set to your project's DSN to activate.
SENTRY_DSN=

# Stripe (dashboard.stripe.com) — billing (Phase 4b). STRIPE_SECRET_KEY is
# secret — never expose it to the frontend (the frontend only ever needs the
# separate, public VITE_STRIPE_PUBLISHABLE_KEY, in the root .env.local/.env.example,
# and doesn't even use that today since checkout redirects go through the
# backend-created Session URL directly). Use a test-mode key
# (sk_test_...) for local/dev; leave unset and every /api/billing/* route
# degrades to a clean 503 rather than crashing the server.
STRIPE_SECRET_KEY=

# Run `node server/scripts/setup-stripe-plans.js` once (idempotent, safe to
# re-run) to create/reuse the Stripe Product+Price for the Pro plan — it
# writes the resulting price id into server/lib/plans.js itself, so nothing
# needs to be set here for that part.

# Webhook signing secret for POST /api/billing/webhook
# (stripe.webhooks.constructEvent). There are two different ways to get a
# value here depending on where the server is reachable from:
#
#   - LOCAL / no public URL yet: this can't be the real production secret,
#     since Stripe only issues one when it can register a reachable
#     endpoint URL. For local verification, either (a) run `stripe listen
#     --forward-to localhost:5050/api/billing/webhook` via the Stripe CLI,
#     which prints a `whsec_...` secret tied to that forwarding session, or
#     (b) construct a signed test event locally with
#     `stripe.webhooks.generateTestHeaderString()` using any string as a
#     shared secret purely to exercise the signature-verification code path
#     end-to-end — this is what Phase 4b's own verification did (see
#     server/lib/billing.js and the route in server/index.js), it does not
#     produce a secret usable in production.
#   - PRODUCTION / once this server has a real public URL: register the
#     endpoint for real, either in the Stripe dashboard (Developers ->
#     Webhooks -> Add endpoint -> point it at
#     https://<your-render-url>/api/billing/webhook, select
#     checkout.session.completed / customer.subscription.updated /
#     customer.subscription.deleted) or via
#     `stripe.webhookEndpoints.create()`. Either way, Stripe then gives you
#     the real `whsec_...` signing secret for that specific endpoint — put
#     that value here (and in Render's environment config, not just this
#     local file).
STRIPE_WEBHOOK_SECRET=

# Comma-separated list of real email addresses allowed to access the
# GET /api/admin/* routes and the frontend's /admin dashboard (Phase 7 Task
# 6). There is no roles/permissions system in this app — this is the
# server-side security boundary: server/middleware/requireAdmin.js checks
# this list against the authenticated user's email from their verified
# Supabase JWT (never a client-supplied value). Leave unset/empty to disable
# admin access entirely (every /api/admin/* request 403s). Case-insensitive,
# whitespace around commas is trimmed. Example:
#   ADMIN_EMAILS=owner@example.com,cofounder@example.com
ADMIN_EMAILS=

# Optional — overrides where Checkout/Portal success/cancel/return URLs
# point. If unset, this is derived from CORS_ORIGIN above (its first entry,
# skipping "*") so there's only one place to configure the frontend origin
# in normal use; set this explicitly only if the billing redirect target
# ever needs to differ from CORS_ORIGIN.
FRONTEND_URL=

# Resend (resend.com) — app-level email sending for automated weekly career
# reports (Phase 7 Task 7), via server/lib/resend.js. This is separate from
# the Resend usage Supabase Auth's own SMTP settings may already have for
# transactional auth emails (password reset) — that's configured entirely
# inside Supabase's dashboard and isn't reachable from app code, so it can't
# be reused here. Leave unset to skip email sending entirely: weekly report
# generation and storage (POST /api/cron/send-weekly-reports) still run and
# persist to the `weekly_reports` table either way — only the actual send
# is skipped, and it's logged clearly why. Get a free API key at
# resend.com/api-keys.
RESEND_API_KEY=

# The verified "from" sender for weekly report emails, e.g.
# "Ascend <reports@yourdomain.com>" — the domain must be verified in the
# Resend dashboard. Leave unset to fall back to Resend's own shared testing
# address (onboarding@resend.dev), which only works for sending to the
# Resend account's own verified email during development/testing, not to
# arbitrary real users.
RESEND_FROM_EMAIL=

# Shared secret for POST /api/cron/send-weekly-reports (Phase 7 Task 7).
# This route is called by an external scheduler (.github/workflows/
# weekly-report.yml, a free GitHub Actions cron — no paid Render Cron Job
# needed) with no user session, so it can't use normal auth — the request
# must carry this exact value in the `X-Cron-Secret` header, compared with
# crypto.timingSafeEqual. Leave unset to disable the route entirely (it
# returns 503 rather than defaulting to "anyone can trigger it"). Generate a
# long random value (e.g. `openssl rand -hex 32`) and set the SAME value in
# two places: this server's environment (Render dashboard) AND as a GitHub
# Actions repository secret named CRON_SECRET — the workflow won't
# authenticate unless both sides match.
CRON_SECRET=

# Job Discovery (Phase 7 Task 8) — selects the active job-listing provider
# for GET /api/jobs/search (server/lib/jobProviders/). "none" (the default if
# unset) uses NullJobProvider: always an empty, honestly-flagged result — no
# scraping, no fabricated postings, since this app has no compliant
# job-listing data provider configured yet. To wire in a real one later, add
# a new provider module implementing the contract in
# server/lib/jobProviders/types.js, register it in
# server/lib/jobProviders/index.js's selectProvider(), and set this to that
# provider's name (plus whatever API key/env vars it needs) — no other code
# changes required.
JOB_PROVIDER=none

# GitHub integration (Phase 7 Task 9) — OAuth connect + repo sync
# (server/lib/github.js, /api/github/* routes). No GitHub OAuth App is
# registered for this project today, so all four vars below are unset by
# default and the whole feature degrades cleanly: GET /api/github/connect
# returns { configured: false } instead of attempting a broken redirect, and
# the frontend's "Connect GitHub" panel shows an honest "not configured yet"
# state. To activate for real:
#
#   1. In your own GitHub account: Settings -> Developer settings -> OAuth
#      Apps -> New OAuth App (https://github.com/settings/applications/new).
#      - Application name / homepage URL: whatever you like (homepage URL
#        just needs to be a valid URL, e.g. your frontend's origin).
#      - Authorization callback URL: MUST be exactly
#        "<this server's public URL>/api/github/callback" — e.g.
#        https://ascend-1-6lyv.onrender.com/api/github/callback. This has to
#        match GITHUB_REDIRECT_URI below byte-for-byte, or GitHub will
#        reject the callback.
#   2. Copy the generated Client ID into GITHUB_CLIENT_ID, and generate +
#      copy a Client Secret into GITHUB_CLIENT_SECRET (secret — never
#      expose it to the frontend).
#   3. Set GITHUB_REDIRECT_URI to that exact same callback URL from step 1.
#   4. Set TOKEN_ENCRYPTION_KEY (see below) if it isn't already set — the
#      integration stays disabled without it even if the three GitHub vars
#      above are all present (this app refuses to store an OAuth access
#      token unencrypted, see server/lib/tokenCrypto.js).
#   5. Set all four in Render's environment config for the real deployment,
#      not just a local .env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# AES-256-GCM key (server/lib/tokenCrypto.js) used to encrypt the GitHub
# OAuth access token before it's stored in `github_connections.
# access_token_encrypted` (supabase/migrations/021_github_integration.sql),
# and reused as the HMAC secret for the OAuth CSRF `state` token
# (server/lib/github.js). Must be a 32-byte key, hex-encoded (64 hex
# characters) — generate one with:
#   openssl rand -hex 32
# Leave unset to disable the GitHub integration entirely (fails closed: no
# new token is ever stored unencrypted, and no OAuth state can be issued).
# Losing/rotating this key invalidates every already-stored GitHub
# connection (they'll fail to decrypt) — users would need to reconnect.
TOKEN_ENCRYPTION_KEY=
