# --- Required ---

# Supabase project (Project Settings → API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is secret — never expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional but recommended (Phase 6a) ---
# Public anon/publishable key — same value as the frontend's
# VITE_SUPABASE_ANON_KEY (Project Settings -> API), safe to expose. When set,
# server/lib/supabaseUser.js builds a per-request RLS-scoped client (using
# the caller's own access token) for ownership-checked lookups on routes like
# /api/generate-cold-email and /api/career-advice, as defense-in-depth on top
# of the explicit user_id filter. If unset, those routes fall back to the
# admin client with an explicit ownership filter (still correct, just without
# the extra RLS layer).
SUPABASE_ANON_KEY=your-anon-key

# Groq (console.groq.com) — free API key, used to run an open-source LLM
# for real resume-bullet rewriting and full-resume critique.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional (sensible defaults / graceful no-op if unset) ---

# Defaults to 5050 if unset.
PORT=5050

# Comma-separated list of allowed origins. Set this to your real frontend
# URL(s) in production — do not leave as "*" once real user data is involved.
# Defaults to "*" (wildcard) if unset.
CORS_ORIGIN=http://localhost:5173

# Set by the hosting platform (Render sets this automatically) — not
# something you normally add to a local .env. When it's exactly
# "production", error responses never echo raw error text to the client.
# NODE_ENV=production

# Upstash Redis (upstash.com, free tier available) — enables Redis-backed
# rate limiting shared across multiple server instances. Leave both unset to
# keep the current in-memory, single-instance rate limiting (fine until this
# API is scaled beyond one Render instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (sentry.io) — backend error/observability reporting. Leave unset to
# skip Sentry entirely (no crash, no warning) — this is the default until a
# Sentry project exists for Ascend. Set to your project's DSN to activate.
SENTRY_DSN=

# Stripe (dashboard.stripe.com) — billing (Phase 4b). STRIPE_SECRET_KEY is
# secret — never expose it to the frontend (the frontend only ever needs the
# separate, public VITE_STRIPE_PUBLISHABLE_KEY, in the root .env.local/.env.example,
# and doesn't even use that today since checkout redirects go through the
# backend-created Session URL directly). Use a test-mode key
# (sk_test_...) for local/dev; leave unset and every /api/billing/* route
# degrades to a clean 503 rather than crashing the server.
STRIPE_SECRET_KEY=

# Run `node server/scripts/setup-stripe-plans.js` once (idempotent, safe to
# re-run) to create/reuse the Stripe Product+Price for the Pro plan — it
# writes the resulting price id into server/lib/plans.js itself, so nothing
# needs to be set here for that part.

# Webhook signing secret for POST /api/billing/webhook
# (stripe.webhooks.constructEvent). There are two different ways to get a
# value here depending on where the server is reachable from:
#
#   - LOCAL / no public URL yet: this can't be the real production secret,
#     since Stripe only issues one when it can register a reachable
#     endpoint URL. For local verification, either (a) run `stripe listen
#     --forward-to localhost:5050/api/billing/webhook` via the Stripe CLI,
#     which prints a `whsec_...` secret tied to that forwarding session, or
#     (b) construct a signed test event locally with
#     `stripe.webhooks.generateTestHeaderString()` using any string as a
#     shared secret purely to exercise the signature-verification code path
#     end-to-end — this is what Phase 4b's own verification did (see
#     server/lib/billing.js and the route in server/index.js), it does not
#     produce a secret usable in production.
#   - PRODUCTION / once this server has a real public URL: register the
#     endpoint for real, either in the Stripe dashboard (Developers ->
#     Webhooks -> Add endpoint -> point it at
#     https://<your-render-url>/api/billing/webhook, select
#     checkout.session.completed / customer.subscription.updated /
#     customer.subscription.deleted) or via
#     `stripe.webhookEndpoints.create()`. Either way, Stripe then gives you
#     the real `whsec_...` signing secret for that specific endpoint — put
#     that value here (and in Render's environment config, not just this
#     local file).
STRIPE_WEBHOOK_SECRET=

# Comma-separated list of real email addresses allowed to access the
# GET /api/admin/* routes and the frontend's /admin dashboard (Phase 7 Task
# 6). There is no roles/permissions system in this app — this is the
# server-side security boundary: server/middleware/requireAdmin.js checks
# this list against the authenticated user's email from their verified
# Supabase JWT (never a client-supplied value). Leave unset/empty to disable
# admin access entirely (every /api/admin/* request 403s). Case-insensitive,
# whitespace around commas is trimmed. Example:
#   ADMIN_EMAILS=owner@example.com,cofounder@example.com
ADMIN_EMAILS=

# Optional — overrides where Checkout/Portal success/cancel/return URLs
# point. If unset, this is derived from CORS_ORIGIN above (its first entry,
# skipping "*") so there's only one place to configure the frontend origin
# in normal use; set this explicitly only if the billing redirect target
# ever needs to differ from CORS_ORIGIN.
FRONTEND_URL=
